# Copia a .env (NO se versiona). Los secretos van en ficheros montados, nunca en el repo.
FIRESTORE_PROJECT_ID=new-amalia-2i5f6m
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase.json   # cuenta de servicio (fichero montado)
FIREBASE_API_KEY=
ACCESS_REGISTRY=/run/secrets/access.json                    # solo hashes sha256 de tokens
PUBLISHING_CONFIG=/run/secrets/publishing.json
KALMA_BRIDGE_KEY_FILE=/run/secrets/kalma-bridge.key
DATA_DIRECTORY=/data
MEDIA_BUCKET=
PUBLIC_BASE=https://example.org/amalia-events
HOST=127.0.0.1
PORT=3120
AMALIA_TOOL_DEADLINE_MS=55000
AMALIA_UNIVERSE_LOAD_MS=40000
